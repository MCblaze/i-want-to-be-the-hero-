MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 753145494}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 80064ff03e390704aa506df46ff33c21, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IWantToBeTheHero.Runtime::IWantToBeTheHero.CandidateRoomGuidance
  rooms:
  - title: Trailhead
    upcomingMechanic: Learn movement and the first safe jumps.
    minX: 0
    maxX: 24
  - title: First courage
    upcomingMechanic: Keep space from thorns. Strike, then recover.
    minX: 24
    maxX: 48
  - title: Broken approach
    upcomingMechanic: Look for the far edge before crossing each gap.
    minX: 48
    maxX: 72
  - title: Ruin crossing
    upcomingMechanic: Keep momentum across broken floor.
    minX: 72
    maxX: 96
  - title: Canopy lesson
    upcomingMechanic: Moving lifts introduce timing and patience.
    minX: 96
    maxX: 120
  - title: Canopy choice
    upcomingMechanic: Use the safer lower route when needed.
    minX: 120
    maxX: 144
  - title: Shrine approach
    upcomingMechanic: Chain ledges and watch enemy spacing.
    minX: 144
    maxX: 168
  - title: Spark shrine
    upcomingMechanic: The Hero Spark unlocks stronger mobility.
    minX: 168
    maxX: 192
  - title: Weapon gallery
    upcomingMechanic: Swap sword and wand to match the threat.
    minX: 192
    maxX: 216
  - title: Mastery crossing
    upcomingMechanic: Mix movement, evasion, and lift timing.
    minX: 216
    maxX: 240
  - title: Court threshold
    upcomingMechanic: The court is close. Your next checkpoint is ahead.
    minX: 240
    maxX: 264
  - title: Guardian court
    upcomingMechanic: "The Guardian is ahead\u2014use every lesson."
    minX: 264
    maxX: 288
